-# Ｂ部品メンテナンス（旧 hiteijomente.asp）。KE部品の定義を見て、項目ごとに登録し直す。
-# Ｂ部品在庫メンテナンスの「部品定義参照」、KE部品の一覧、注文部品の部品コードから開く。
- content_for :page_title, "Ｂ部品メンテナンス"
- input_cls = "input input-bordered input-xs border-2 border-neutral bg-base-100 flex-1"
- btn_cls = "btn btn-xs wtext btn-info"
- head_cls = "bg-primary text-primary-content"
- centered = "text-align: center;"
- number = ->(value) { value.to_i.to_s.gsub(/(?<=\d)(?=(?:\d{3})+(?!\d))/, ",") }
-# [列, 項目名, 現在の値の表示, ボタン名, 入力欄の幅, 英数字だけの欄か]（旧ASPの並び順とボタン名）
- rows = [ |
  [:size, "寸法", @kepart.size, "寸法登録", "30rem", false], |
  [:form, "形式", @kepart.form, "形式登録", "30rem", false], |
  [:itemno, "ItemNo", @kepart.itemno, "ItemNo登録", "30rem", true], |
  [:jname, "和文名称", @kepart.jname, "和文名称変更登録", "30rem", false], |
  [:ename, "英文名称", @kepart.ename, "英文名称変更登録", "30rem", false], |
  [:munit, "計測単位", @kepart.munit, "計測単位登録", "10rem", true], |
  [:weightkg, "重量(kg)", @kepart.weightkg, "重量登録", "10rem", true], |
  [:newprice, "参考単価", (number.call(@kepart.newprice) unless @kepart.newprice.nil?), "参考単価登録", "10rem", true], |
  [:comment, "備考", @kepart.comment, "備考登録", "40rem", false] |
] |

.mb-3.flex.items-center.gap-3
  = link_to "戻る", (@return_path || "javascript:history.back()"), class: "btn btn-sm btn-info"
  %span 部品コード #{@kepart.pcode}

%table.center-table.radius-table.row-compact{width: "99%", align: "center"}
  %tr{class: head_cls}
    %th{width: "12%"} 項目
    %th{width: "26%"} 現在の値
    %th 変更
  %tr
    -# 項目名のセルは、他の画面（国別為替の詳細など）と同じ、濃い青地に白文字
    %th{class: head_cls} 部品コード
    %td{style: "#{centered} font-weight: bold; font-size: 1.2em;"}= @kepart.pcode
    %td
      = link_to "部品在庫参照", stockb_maintenance_path(partno: @kepart.pcode), class: "btn btn-sm btn-info"
  - rows.each do |field, label, current, button, width, ascii|
    %tr
      %th{class: head_cls}= label
      %td{style: centered}= current
      %td
        -# 1項目ずつ登録する（旧ASPも、項目ごとにフォームが分かれていた）
        = form_with url: kepart_field_path(@kepart), method: :patch, class: "flex items-center gap-2" do
          = hidden_field_tag :field, field, id: nil
          = text_field_tag :value, @kepart[field], id: "kepart_#{field}", autocomplete: "off", class: input_cls, style: "max-width: #{width};#{' ime-mode:disabled;' if ascii}"
          = submit_tag button, name: nil, class: btn_cls
        - if field == :newprice
          %span.TB12 Ｂ部品の時価は、取引毎に入力しますのでここでの入力は参考のみ。（注文の明細に追加するときの、初めの単価になります）
        - if field == :weightkg
          %span.TB12 空欄にして登録すると、重量を消去します。

%p.TB12{style: "margin: 8px 0 0 30px;"}
  項目ごとに、入力してボタンをクリックすると、その項目だけを登録します。

.mt-6.text-center
  = button_to "この部品を削除する", kepart_path(@kepart), method: :delete, class: "btn btn-sm btn-error text-white",
    form: { data: { turbo_confirm: "Ｂ部品「#{@kepart.pcode}」を削除します。元に戻せません。よろしいですか？" } }
  %p.TB12{style: "margin-top: 4px;"}
    - if @stockb_rows.positive?
      この部品の在庫台帳Bの履歴（#{@stockb_rows} 件）は、部品を削除しても消えません。
    - else
      この部品の在庫台帳Bの履歴はありません。
