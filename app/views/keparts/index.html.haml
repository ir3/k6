- model_class = Kepart
- content_for :page_title, "Ｂ部品台帳表示"
-# 上部の2つの枠（旧 hiteijosel.asp）。検索は部品コードの一部、新規登録は部品コードを入れて登録画面へ移る
- input_cls = "input input-bordered input-sm border-2 border-neutral bg-base-100 w-44"
- btn_cls = "btn btn-sm wtext btn-info"
.mb-3.flex.flex-wrap.items-center.gap-x-6.gap-y-2
  = form_with url: keparts_path, method: :get, class: "flex flex-wrap items-center gap-2" do
    %span 有効な検索条件：#{@keyword}
    %span.TB12 部品コードの一部を指定
    = text_field_tag :keyword, @keyword, id: "keparts_keyword", size: 16, autocomplete: "off", class: input_cls, style: "ime-mode:disabled;"
    = submit_tag "Ｂ検索", name: nil, class: btn_cls
  = form_with url: new_kepart_path, method: :get, class: "flex items-center gap-2" do
    = text_field_tag :nparts, @keyword, id: "keparts_nparts", size: 16, autocomplete: "off", class: input_cls, style: "ime-mode:disabled;"
    = submit_tag "新規Ｂ部品登録", name: nil, class: btn_cls
%table
  %tr
    %td
      = paginate @keparts, window: 4, outer_window: 5, left: 1, right: 3

%table.center-table.radius-table.zebra-table.list-table{width: "99%", align:"center"}
  %thead.bg-primary.text-primary-content
    %tr.headline
      %th{style: 'width:30px'}= 'No.'
      %th{style: 'width:30px'}= model_class.human_attribute_name(:id)
      %th{style: 'width:90px'}= model_class.human_attribute_name(:pcode)
      %th= model_class.human_attribute_name(@tilde ? :size : :form)
      %th= model_class.human_attribute_name(:jname)
      %th= model_class.human_attribute_name(:price)+'(円)'
      %th= model_class.human_attribute_name(:stock)
      %th= model_class.human_attribute_name(:sel_unit)
      %th= model_class.human_attribute_name(:weightkg)
      %th= model_class.human_attribute_name(:munit)
      %th= model_class.human_attribute_name(:itemno)
      %th= model_class.human_attribute_name(:cordno)
      %th= model_class.human_attribute_name(:comment)
      %th.datej= model_class.human_attribute_name(:updated_at)
  %tbody
    - @keparts.each_with_index do |kepart, i|
      %tr
        %td{style: 'text-align:center'}= i+1
        %td{style: 'text-align:center'}= link_to kepart.id, kepart_path(kepart)
        %td= link_to kepart.pcode, kepart_path(kepart)
        %td= @tilde ? kepart.size : kepart.form
        %td= kepart.jname
        %td{style: 'text-align:right'}= kepart.price.to_s.gsub(/(\d)(?=(\d{3})+(?!\d))/, '\1,')
        %td= kepart.stock
        %td= kepart.sel_unit
        %td= kepart.weightkg
        %td= kepart.munit
        %td= kepart.itemno
        %td= kepart.cordno
        %td= kepart.comment
        %td= kepart.updated_at.strftime('%Y/%m/%d %H:%M')
