-# Ａ部品メンテナンス（旧 partsmente.asp）。部品台帳の定義を見て、項目ごとに登録し直す。
-# Ａ部品台帳表示の部品コード、注文明細・並べ替え画面の部品コードから開く。
- content_for :page_title, "Ａ部品メンテナンス"
- input_cls = "input input-bordered input-xs border-2 border-neutral bg-base-100 flex-1"
- btn_cls = "btn btn-xs wtext btn-info"
- head_cls = "bg-primary text-primary-content"
- centered = "text-align: center;"
- number = ->(value) { value.to_i.to_s.gsub(/(?<=\d)(?=(?:\d{3})+(?!\d))/, ",") }
-# [列, 項目名, 現在の値の表示, 入力欄の初期値, ボタン名, 入力欄の幅, 英数字だけの欄か, 説明]（旧ASPの並び順とボタン名）
- price_note = "掛け率の掛からない単価を入力してください。"
- rows = [ |
  [:form, "形式", @part.form, @part.form, "形式変更登録", "30rem", false, nil], |
  [:jname, "和文名称", @part.jname, @part.jname, "和文名称変更登録", "30rem", false, nil], |
  [:ename, "英文名称", @part.ename, @part.ename, "英文名称変更登録", "30rem", false, nil], |
  [:sel_unit, "販売単位", @part.sel_unit, @part.sel_unit, "販売単位変更登録", "10rem", false, nil], |
  [:weightkg, "重量(kg)", @part.weightkg, @part.weightkg, "重量変更登録", "10rem", true, "空欄にして登録すると、重量を消去します。"], |
  [:munit, "計測単位", @part.munit, nil, nil, nil, nil, nil], |
  [:newprice, "新単価", (number.call(@part.newprice) unless @part.newprice.nil?), @part.newprice, "新単価変更", "10rem", true, price_note], |
  [:price, "現行単価", (number.call(@part.price) unless @part.price.nil?), @part.price, "旧単価登録", "10rem", true, price_note], |
  [:comment, "備考", @part.comment, @part.comment, "備考変更登録", "40rem", false, nil] |
] |

.mb-3.flex.items-center.gap-3
  = link_to "戻る", :back, class: "btn btn-sm btn-info"
  %span 部品コード #{@part.pcode}

%table.center-table.radius-table.row-compact{width: "99%", align: "center"}
  %tr{class: head_cls}
    %th{width: "12%"} 項目
    %th{width: "26%"} 現在の値
    %th 変更
  %tr
    -# 項目名のセルは、他の画面（国別為替の詳細など）と同じ、濃い青地に白文字
    %th{class: head_cls} 部品コード
    %td{style: "#{centered} font-weight: bold; font-size: 1.2em;"}= @part.pcode
    %td
      = link_to "部品在庫参照", stock_maintenance_path(partno: @part.pcode), class: "btn btn-sm btn-info"
  - rows.each do |field, label, current, initial, button, width, ascii, note|
    %tr
      %th{class: head_cls}= label
      %td{style: centered}= current
      %td
        - if button
          -# 1項目ずつ登録する（旧ASPも、項目ごとにフォームが分かれていた）
          = form_with url: part_field_path(@part), method: :patch, class: "flex items-center gap-2" do
            = hidden_field_tag :field, field, id: nil
            = text_field_tag :value, initial, id: "part_#{field}", autocomplete: "off", class: input_cls, style: "max-width: #{width};#{' ime-mode:disabled;' if ascii}"
            = submit_tag button, name: nil, class: btn_cls
          - if note
            %span.TB12= note
  %tr
    %th{class: head_cls} 更新日
    %td{style: centered}= @part.updated_at&.strftime("%Y/%m/%d %H:%M")
    %td
  %tr
    %th{class: head_cls} 旧部品番号
    %td{style: centered}= @old_part_number
    %td
      = form_with url: part_field_path(@part), method: :patch, class: "flex items-center gap-2" do
        = hidden_field_tag :field, :opartno, id: nil
        = text_field_tag :value, @old_part_number, id: "part_opartno", autocomplete: "off", class: input_cls, style: "max-width: 15rem; ime-mode:disabled;"
        = submit_tag "旧部品番号を登録", name: nil, class: btn_cls
      %span.TB12 この部品の古い部品番号があれば、その古い部品番号を入力してください。

%p.TB12{style: "margin: 8px 0 0 30px;"}
  項目ごとに、入力してボタンをクリックすると、その項目だけを登録します。

-# 元の情報を保持して、新しい部品コードの部品を作る
.mt-6.text-center
  = form_with url: part_duplicate_path(@part), method: :post, class: "inline-flex items-center gap-2" do
    = text_field_tag :new_code, @part.pcode, id: "part_new_code", autocomplete: "off", class: input_cls, style: "width: 14rem; ime-mode:disabled;"
    = submit_tag "新部品を複製", name: nil, class: btn_cls
  %p.TB12{style: "margin-top: 4px;"}
    元の情報を保持して、新しい部品を新規作成するには、新しい部品番号に修正してください。

.mt-6.text-center
  = button_to "この部品を削除する", part_path(@part), method: :delete, class: "btn btn-sm btn-error text-white",
    form: { data: { turbo_confirm: "Ａ部品「#{@part.pcode}」を削除します。元に戻せません。よろしいですか？" } }
  %p.TB12{style: "margin-top: 4px;"}
    - if @stock_rows.positive?
      この部品の在庫台帳の履歴（#{@stock_rows} 件）は、部品を削除しても消えません。
    - else
      この部品の在庫台帳の履歴はありません。
