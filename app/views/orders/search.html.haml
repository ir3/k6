- model_class = Order
= paginate @orders, window: 4, outer_window: 5, left: 1, right: 3
%table.center-table.radius-table.list-table{width: "99%", align:"center"}
  %thead.bg-primary.text-primary-content.th-compact
    %tr
      %th{width:"95px"}= link_to '取引No↑↓', orders_search_path(keyword: params[:keyword], keykind: params[:keykind], mno_order: session[:mno_order]), class: "btn btn-sm wtext btn-info"
      %th 客No.
      %th 客先
      %th 型式
      %th 機番
      %th{width:"100px"} 船名
      %th{width:"45px"} 船籍
      %th{width:"45px"} 点数
      %th 件名
      %th 客先注文番号
      %th Memo
      %th Tc Tcno Zp Zpno Glc Glcno Mg Mgno
  %tbody
    = render @orders
    = hidden_field_tag('authenticity_token', form_authenticity_token)
= paginate @orders, window: 4, outer_window: 5, left: 1, right: 3
