-# 取引台帳修正（asp/orderup.asp をもとにした画面）
-# ASPの「日付」は納入期日(rdate)、「納入期日」(textarea)は納入コメント(ncomment)として扱う。
-# 取引先は50音ボタンのモーダルで選ぶ（画面遷移しないので入力途中の内容は保持される）。
- input_cls = "input input-bordered input-sm border-2 border-neutral bg-base-100"
-# min-h-0: DaisyUI の textarea は最小の高さがあり、rows を小さくしても縮まないため外す
- ta_cls    = "textarea textarea-bordered border-2 border-neutral bg-base-100 w-full min-h-0"
- sel_cls   = "select select-bordered select-sm border-2 border-neutral bg-base-100"
- latin     = "ime-mode:disabled;"
- adlist    = Adlist.find_by(no: @order.adlist_id.to_s)
- company   = adlist ? adlist_company_name(adlist) : "（取引先未登録）"
- section   = adlist_section_name(adlist)
- base_year = (@order.rdate || Date.current).year

- if @order.errors.any?
  .alert.alert-error.mb-3{role: "alert"}
    %ul
      - @order.errors.full_messages.each do |msg|
        %li= msg

.mb-3.flex.gap-2
  = link_to "注文部品詳細へ戻る", order_path(@order), class: "btn btn-sm btn-info"
  = link_to "取引台帳へ", orders_path, class: "btn btn-sm btn-info"

%div{data: {controller: "adlist-picker"}}
  = form_with model: @order, url: order_path(@order), method: :patch do |f|
    = f.hidden_field :adlist_id, data: {adlist_picker_target: "adlistId"}
    -# 表全体は8列（ラベル・値 × 4組）。T/C〜MG は1行に4組並べて2行にし、
    -# それ以外の行は「ラベル + 値(3列分)」を左右に並べて同じ列にそろえる。
    %table.center-table.radius-table.row-compact.edit-table{width: "99%", align: "center"}
      %tr
        %th 納入期日
        %td{colspan: 3}= f.date_select :rdate, {use_month_numbers: true, date_separator: " / ", start_year: [base_year, Date.current.year - 1].min, end_year: [base_year, Date.current.year + 1].max}, {class: "#{sel_cls} w-24"}
        %th 管理番号
        %td= @order.mno
        %th 更新日時
        %td= @order.updated_at.strftime("%Y/%m/%d %H:%M")
      %tr
        %th{rowspan: 3} 取引先選択
        %td{rowspan: 3, colspan: 3}= render "orders/kana_buttons", open: true
        %th 会社名
        %td{colspan: 3, data: {adlist_picker_target: "company"}}= company
      %tr
        %th 部署名
        %td{colspan: 3, data: {adlist_picker_target: "section"}}= section
      %tr
        %th 船名
        %td{colspan: 3}= f.text_field :shipname, class: "#{input_cls} w-80"
      %tr
        %th 型式(機種)
        %td{colspan: 3}= f.text_field :etype, class: "#{input_cls} w-80"
        %th 注文番号
        %td{colspan: 3}= f.text_field :ono, class: "#{input_cls} w-80"
      %tr
        %th 機番
        %td{colspan: 3}= f.text_field :engno, class: "#{input_cls} w-80"
        %th 船籍
        %td{colspan: 3}= f.select :country, country_options(@order.country), {}, {class: "#{sel_cls} w-80"}
      %tr
        %th T/C形式
        %td= f.text_field :tc, class: "#{input_cls} w-48", style: latin
        %th T/C No.
        %td= f.text_field :tcno, class: "#{input_cls} w-48", style: latin
        %th ZP形式
        %td= f.text_field :zp, class: "#{input_cls} w-48", style: latin
        %th ZP No.
        %td= f.text_field :zpno, class: "#{input_cls} w-48", style: latin
      %tr
        %th GLC形式
        %td= f.text_field :glc, class: "#{input_cls} w-48", style: latin
        %th GLC No.
        %td= f.text_field :glcno, class: "#{input_cls} w-48", style: latin
        %th MG形式
        %td= f.text_field :mg, class: "#{input_cls} w-48", style: latin
        %th MG No.
        %td= f.text_field :mgno, class: "#{input_cls} w-48", style: latin
      %tr
        %th 件名
        %td{colspan: 7}= f.text_field :orderitem, class: "#{input_cls} w-full"
      %tr
        %th 内容
        %td{colspan: 7}= f.text_area :memo, rows: 6, class: ta_cls
      %tr
        %th 納入コメント
        -# 未設定(nil)の時だけ既定の文言を入れる（ASPと同じ）
        - comment_opts = {rows: 2, class: ta_cls}
        - comment_opts[:value] = "御社御下命後４日" if @order.ncomment.nil?
        %td{colspan: 7}= f.text_area :ncomment, comment_opts

    .mt-3.flex.justify-center.gap-3
      = f.submit "修正実行", class: "btn btn-primary"
      = link_to "修正しないで戻り", order_path(@order), class: "btn"

  -# 取引先選択モーダル。フォームの外に置く（中のボタンが修正フォームを送信しないように）。
  %dialog.modal{data: {adlist_picker_target: "dialog"}}
    .modal-box.max-w-5xl
      = turbo_frame_tag "adlist_picker" do
        %p 50音ボタンで取引先を選んでください。
    %form.modal-backdrop{method: "dialog"}
      %button{type: "submit"} 閉じる
