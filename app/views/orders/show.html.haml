      = @order.shipname
    %th.bg-primary.text-primary-content{width:"60px", style: 'font-size: 11px;'} 船籍
    %td{style:'text-align:center;'}
      = @order.country
%table.center-table.radius-table.row-compact{width: "99%", align:"center"}
  %tr
