%table.center-table.radius-table.row-compact{width: "99%", align:"center"}
  %tr
    %th.bg-primary.text-primary-content{width:"100px", style: 'font-size: 11px;'} 納入期日
    %td{width:"150px"}= @order.rdate
    %th.bg-primary.text-primary-content{width:"160px", style: 'font-size: 11px;'} 納入コメント
    %td{width: "300px"}= @order.ncomment
    %th.bg-primary.text-primary-content{width:"80px", style: 'font-size: 11px;'} 点数
    %td= @order.pnum
    %th.bg-primary.text-primary-content{width:"150px", style: 'font-size: 11px;'} A部品掛け率
    %td{width:"80px"}= @order.irate
    %th.bg-primary.text-primary-content{width:"140px", style: 'font-size: 11px;'}  以外掛け率
    %td{width:"80px"}= @order.irate2
    %th.bg-primary.text-primary-content{width:"80px", style: 'font-size: 11px;'} 値引き
    %td= @order.nebiki
    %th.bg-primary.text-primary-content{width:"50px", style: "font-size: 11px;"}
      更新
      %br
      日時
    %td.datej{width: "72px", style: "font-size: 9px;"}= @order.updated_at.strftime("%Y/%m/%d %H:%M")
%table
  %tr
    %td
      見積依頼出力日
    %td
      = @order.ndate
      %br
        初回見積出力日
      %br= @order.mitday
    %td
      最新見積出力日
      %br= @order.ldate
    %td
      受注or受注メモ出力日
      %br= @order.tcondition
    %td
      納品or納品書(請求要となった)日
      %br= @order.pnum
    %td
      出荷案内出力(請求要となった)日
      %br= @order.syuday
    %td
      請求or請求書出力日
      %br= @order.seiday
    %td
      入金(確認)日
%table.center-table.radius-table.row-compact.zebra-table.list-table{width: "99%", align:"center"}
  %thead.bg-primary.text-primary-content
    %tr
      %th{width:"25px", style: 'font-size: 11px;'} 順
      %th{width:"120px", style: 'font-size: 11px;'} 部品コード
      %th{width:"130px", style: 'font-size: 11px;'} ItemNo
      %th{width:"", style: 'font-size: 11px;'} 名称
      %th{width:"", style: 'font-size: 11px;'} 備考
      %th{width:"80px", style: 'font-size: 11px;'} (掛率)
      %th{width:"60px", style: 'font-size: 11px;'} 数量
      %th{width:"50px", style: 'font-size: 11px; white-space: nowrap;'} 販売単位
      %th{width:"60px", style: 'font-size: 11px;'} バラ
      %th{width:"90px", style: 'font-size: 11px;'} 総重量kg
      %th{width:"90px", style: 'font-size: 11px;'} 販売単価
      %th{width:"110px", style: 'font-size: 11px;'} 金額
      %th.updated-at-col{width:"75px", style: 'font-size: 11px; white-space: nowrap;'} 更新日時
  - a_group = []
  - b_group = []
  - c_group = []
  - @orderparts.each do |orderpart|
    - found_part = Part.find_by(pcode: orderpart.partno)
    - found_kepart = found_part ? nil : Kepart.find_by(pcode: orderpart.partno)
    - entry = { orderpart: orderpart, part: (found_part || found_kepart), part_source: (found_part ? :part : (found_kepart ? :kepart : nil)) }
    - if found_part
      - a_group << entry
    - elsif found_kepart
      - b_group << entry
    - else
      - c_group << entry
  - amount_of = ->(orderpart) { (orderpart.irate.to_f * orderpart.qty.to_f * orderpart.unitpd.to_f).round }
  - a_subtotal = a_group.sum { |e| amount_of.call(e[:orderpart]) }
  - b_subtotal = b_group.sum { |e| amount_of.call(e[:orderpart]) }
  - c_subtotal = c_group.sum { |e| amount_of.call(e[:orderpart]) }
  - n_group = NOrderpart.where(mno: @order.mno).order(:sno)
  - n_subtotal = n_group.select { |np| np.tvalid.to_i == 1 }.sum { |np| np.totala.to_i }
  - total = a_subtotal + b_subtotal + c_subtotal + n_subtotal
  - after_discount = total - @order.nebiki.to_i
  - tax = (after_discount * 10 / 100.0).round
  - grand_total = after_discount + tax
  %tbody
  - a_group.each do |e|
    = render "order_part_row", **e
  - if a_subtotal != 0
    = render "order_part_summary_row", label: "A部品小計", value: a_subtotal
  - b_group.each do |e|
    = render "order_part_row", **e
  - if b_subtotal != 0
    = render "order_part_summary_row", label: "B部品小計", value: b_subtotal
  - if n_group.any?
    - n_group.each do |n_orderpart|
      = render "n_orderpart_row", n_orderpart: n_orderpart
    - if n_subtotal != 0
      = render "order_part_summary_row", label: "部品番号無小計", value: n_subtotal
  - if c_group.any?
    - c_group.each do |e|
      = render "order_part_row", **e
    = render "order_part_summary_row", label: "部品番号不明小計", value: c_subtotal
  = render "order_part_summary_row", label: "合計", value: total
  = render "order_part_discount_row", order: @order, after_discount: after_discount
  = render "order_part_summary_row", label: "値引き&消費税合計(10%)", value: grand_total
