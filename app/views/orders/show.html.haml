      = @order.engno
    %th.bg-primary.text-primary-content{width:"150px", style: 'font-size: 11px;'} 型式(機種)
    %td{width:"120px",style:'text-align:center;'}
      = @order.etype
    %th.bg-primary.text-primary-content{width:"100px", style: 'font-size: 11px;'} 客先註番
    %td= @order.ono
%table.center-table.radius-table.row-compact{width: "99%", align:"center"}
