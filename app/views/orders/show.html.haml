    %td= @order.tc
    %th.bg-primary.text-primary-content{width:"55px", style: 'font-size: 11px;'} TCNo.
    %td= @order.tcno
    %th.bg-primary.text-primary-content{width:"40px", style: 'font-size: 11px;'} ZP
    %td= @order.zp
    %th.bg-primary.text-primary-content{width:"55px", style: 'font-size: 11px;'} ZPNo.
    %td= @order.zpno
    %th.bg-primary.text-primary-content{width:"40px", style: 'font-size: 11px;'} GLC
    %td= @order.glc
    %th.bg-primary.text-primary-content{width:"55px", style: 'font-size: 11px;'} GLNo.
    %td= @order.glcno
    %th.bg-primary.text-primary-content{width:"40px", style: 'font-size: 11px;'} MG
    %td= @order.mg
    %th.bg-primary.text-primary-content{width:"55px", style: 'font-size: 11px;'} MGNo.
    %td= @order.mgno
%table.center-table.radius-table.row-compact{width: "99%", align:"center"}
  %tr
    %th.bg-primary.text-primary-content{width:"70px", style: 'font-size: 11px; white-space:nowrap;'} 納入期日
    %td{width:"100px", style: 'white-space:nowrap;'}= @order.rdate
    %th.bg-primary.text-primary-content{width:"90px", style: 'font-size: 11px; white-space:nowrap;'} 納入コメント
    %td
      %div{style: "width:450px; white-space:nowrap;"}= @order.ncomment
    %th.bg-primary.text-primary-content{width:"60px", style: 'font-size: 11px; white-space:nowrap;'} 点数
    %td
      %div{style: "width:40px; white-space:nowrap;"}= @order.pnum
    %th.bg-primary.text-primary-content.updated-at-col{width:"50px", style: "font-size: 11px;"}
      更新
      %br
      日時
    %td.datej.updated-at-col{width: "72px", style: "font-size: 9px;"}= @order.updated_at.strftime("%Y/%m/%d %H:%M")
-# 各種出力日（旧 partsin.asp の請求管理）。帳票出力履歴の日付を、8項目の表にまとめる。
-# 未出力は「未」、手で入れた日付は青字で出す。
-# 日付を手で入れる欄（旧 torihikikanri.asp）: チェックボックスと日付と「日付更新」は、表の中のセルに散らばるので、
-# 掛け率と同じく、空のフォームを表の外に置き、form 属性で関連付ける。チェックボックスが付くのは、旧ASPと同じ6項目（kubun の値）
- output_items = [ |
  ["見積依頼出力日", nil, nil, @output_dates.request], |
  ["初回見積出力日", nil, nil, @output_dates.first_estimate], |
  ["最新見積出力日", nil, 102, @output_dates.latest_estimate], |
  ["受注/受注メモ出力日", nil, 103, @output_dates.order_memo], |
  ["納品書出力日", "(請求要となった日)", 107, @output_dates.delivery], |
  ["出荷案内出力日", "(請求要となった日)", 104, @output_dates.shipping], |
  ["請求書出力日", nil, 105, @output_dates.invoice], |
  ["入金(確認)日", nil, 106, @output_dates.payment] |
] |
%form#order_output_dates_form{method: "post", action: output_dates_order_path(@order)}
  = hidden_field_tag("authenticity_token", form_authenticity_token, id: nil)
%table.center-table.radius-table.row-compact{width: "99%", align:"center"}
  %tr
    - output_items.each do |label, note, _kubun, _entry|
      %th.output-dates-head{width: "12.5%", style: 'font-size: 11px;'}
        = label
        - if note
          %br
          %span= note
  %tr
    - output_items.each do |label, _note, kubun, entry|
      %td{style: "text-align:center; white-space:nowrap;"}
        - if kubun
          = check_box_tag "kubun[]", kubun, false, id: "output_kubun_#{kubun}", form: "order_output_dates_form", title: "#{label}に、右の日付を登録する"
        - if entry
          %span{style: ("color:#1d4ed8;" if entry.manual), title: ("手動で入力した日付" if entry.manual)}= entry.date.strftime("%Y/%m/%d")
        - else
          %span{style: "color:#9ca3af;"} 未
  %tr
    %td{colspan: 8, style: "text-align:left; white-space:nowrap;"}
      %span.TB12 日付を手で登録: 項目にチェックを入れ、日付を入力して「日付更新」（チェックした項目すべてに、同じ日付を登録）
      = date_field_tag :inputday, Date.current.strftime("%Y-%m-%d"), id: "output_inputday", form: "order_output_dates_form", class: "input input-bordered input-xs border-2 border-neutral bg-base-100", style: "width: 9rem; ime-mode:disabled; margin-left: 8px;"
      = submit_tag "日付更新", form: "order_output_dates_form", name: nil, class: "btn btn-xs wtext btn-info", style: "margin-left: 4px;"
%table
  %tr
    %td{style:"padding: 5px 5px 5px 30px;"}
      %form{method:"post", action: "#{orders_keycopy_path}", name: "order_key_copy"}
        = hidden_field_tag('authenticity_token', form_authenticity_token)
        %input{type: "submit", value: "取引先、船名、機番を複製し新規取引登録", class: "btn wtext btn-info"}
    %td{style:"padding: 5px 5px 5px 30px;"}
      %form{method:"post", action: "#{orders_copy_path}", name: "order_copy"}
        = hidden_field_tag('authenticity_token', form_authenticity_token)
        %input{type: "submit", value: "部品詳細も複製し新規取引登録",  class: "btn wtext btn-info"}
    %td{style:"padding: 5px 5px 5px 30px;"}
      = link_to "台帳を修正", edit_order_path,  class: "btn wtext btn-info"
    %td{style:"padding: 5px 5px 5px 30px;"}
      = button_to "台帳から削除", order_path(@order), method: :delete, form: {data: {turbo_confirm: "取引 #{@order.mno} を削除します。部品明細も削除されます。よろしいですか？"}}, class: "btn wtext btn-info"
    %td{style:"padding: 5px 5px 5px 30px;"}
      = link_to "並び替え後表示", sorted_order_path(@order), class: "btn wtext btn-info"
-# 旧 partsin.asp の「部品番号を入力して部品選択」。部品番号で部品明細を追加する(partsreg3.asp 相当)
%form.flex.items-center.gap-2{method: "post", action: add_part_order_path(@order), style: "margin: 6px 0; padding-left: 30px;"}
  = hidden_field_tag("authenticity_token", form_authenticity_token, id: nil)
  = text_field_tag :partsno, nil, size: 12, maxlength: 30, autocomplete: "off", placeholder: "部品番号", class: "input input-bordered input-xs border-2 border-neutral bg-base-100", style: "ime-mode:disabled; width: 10rem;"
  = submit_tag "部品番号を入力して部品選択", name: nil, class: "btn btn-xs wtext btn-info"
-# 掛け率の入力欄は表の中のセルに散らばるので、空のフォームを表の外に置き、form 属性で関連付ける
%form#order_rate_form{method: "post", action: order_path(@order)}
  = hidden_field_tag(:_method, "patch", id: nil)
  = hidden_field_tag("authenticity_token", form_authenticity_token, id: nil)
-# 旧 partsin.asp の「部品番号が不明な分を部品名入力」。部品名だけで部品番号なしの明細を仮登録する(partsreg5.asp 相当)。
-# 掛け率と同じく、セルに置く入力欄は空のフォームに form 属性で関連付ける
%form#order_part_name_form{method: "post", action: add_part_name_order_path(@order)}
  = hidden_field_tag("authenticity_token", form_authenticity_token, id: nil)
- rate_cls = "input input-bordered input-xs border-2 border-neutral bg-base-100"
%table.center-table.radius-table.row-compact{width: "99%", align:"center"}
  %tr
    %td{style: "text-align: left; white-space: nowrap;"}
      = text_field_tag :partsname, nil, form: "order_part_name_form", maxlength: OrderPartNameAdder::MAX_LENGTH, autocomplete: "off", placeholder: "部品名", class: rate_cls, style: "width: 22rem;"
      = submit_tag "部品番号が不明な分を部品名入力", form: "order_part_name_form", name: nil, class: "btn btn-xs wtext btn-info"
    %th.bg-primary.text-primary-content{width:"120px", style: 'font-size: 11px;'} A部品掛け率
    %td{width:"80px"}= number_field_tag "order[irate]", @order.irate, form: "order_rate_form", step: "any", min: 0, class: rate_cls, style: "width: 5rem; text-align: right;"
    %th.bg-primary.text-primary-content{width:"110px", style: 'font-size: 11px;'}  以外掛け率
    %td{width:"80px"}= number_field_tag "order[irate2]", @order.irate2, form: "order_rate_form", step: "any", min: 0, class: rate_cls, style: "width: 5rem; text-align: right;"
    %td= submit_tag "掛け率変更", form: "order_rate_form", name: nil, class: "btn btn-xs wtext btn-info"
%table.center-table.radius-table.row-compact.zebra-table.list-table{width: "99%", align:"center"}
  %thead.bg-primary.text-primary-content
    %tr
      %th{width:"25px", style: 'font-size: 11px;'} 順
      %th{width:"120px", style: 'font-size: 11px;'} 部品コード
      %th{width:"130px", style: 'font-size: 11px;'} ItemNo
      %th{width:"", style: 'font-size: 11px;'} 名称
      %th{width:"", style: 'font-size: 11px;'} 備考
      %th{width:"80px", style: 'font-size: 11px;'} (掛率)
      %th{width:"60px", style: 'font-size: 11px;'} 数量
      %th{width:"50px", style: 'font-size: 11px; white-space: nowrap;'} 販売単位
      %th{width:"60px", style: 'font-size: 11px;'} バラ
      %th{width:"90px", style: 'font-size: 11px;'} 総重量kg
      %th{width:"90px", style: 'font-size: 11px;'} 販売単価
      %th{width:"110px", style: 'font-size: 11px;'} 金額
      %th.updated-at-col{width:"75px", style: 'font-size: 11px; white-space: nowrap;'} 更新日時
  - a_group = []
  - b_group = []
  - c_group = []
  - @orderparts.each do |orderpart|
    - found_part = Part.find_by(pcode: orderpart.partno)
    - found_kepart = found_part ? nil : Kepart.find_by(pcode: orderpart.partno)
    - entry = { orderpart: orderpart, part: (found_part || found_kepart), part_source: (found_part ? :part : (found_kepart ? :kepart : nil)) }
    - if found_part
      - a_group << entry
    - elsif found_kepart
      - b_group << entry
    - else
      - c_group << entry
  -# 金額は明細の表示と同じ求め方(ItemPricing: 掛け率を掛けて切り上げまるめ。バラ売りはバラ単価)
  - amount_of = ->(e) { ItemPricing.for_orderpart(e[:orderpart], sel: e[:orderpart].unit.presence || e[:part]&.sel_unit, rate: ItemPricing.effective_rate(@order, e[:part_source], e[:orderpart].irate)).amount }
  - a_subtotal = a_group.sum { |e| amount_of.call(e) }
  - b_subtotal = b_group.sum { |e| amount_of.call(e) }
  - c_subtotal = c_group.sum { |e| amount_of.call(e) }
  -# 部品番号なしの明細も、Orderpartと同じく「順(SNo)」順(同じ順は作成順＝古いものが上)で表示する
  - n_group = NOrderpart.where(mno: @order.mno).order(Arel.sql("COALESCE(sno, 0)"), :id)
  - n_subtotal = n_group.select { |np| np.tvalid.to_i == 1 }.sum { |np| ItemPricing.for_n_orderpart(np, fallback_rate: @order.irate2).amount }
  - total = a_subtotal + b_subtotal + c_subtotal + n_subtotal
  - after_discount = total - @order.nebiki.to_i
  - tax_rate = @order.effective_tax_rate
  - tax = (after_discount * tax_rate / 100.0).round
  - grand_total = after_discount + tax
  %tbody
  - a_group.each do |e|
    = render "order_part_row", **e
  -# A部品小計・B部品小計の行は、薄黄緑
  - subtotal_bg = "#e2efbd"
  - if a_subtotal != 0
    = render "order_part_summary_row", label: "A部品小計", value: a_subtotal, bg: subtotal_bg
  - b_group.each do |e|
    = render "order_part_row", **e
  - if b_subtotal != 0
    = render "order_part_summary_row", label: "B部品小計", value: b_subtotal, bg: subtotal_bg
  - if n_group.any?
    - n_group.each do |n_orderpart|
      = render "n_orderpart_row", n_orderpart: n_orderpart, fallback_rate: @order.irate2
    - if n_subtotal != 0
      = render "order_part_summary_row", label: "その他小計", value: n_subtotal
  - if c_group.any?
    - c_group.each do |e|
      = render "order_part_row", **e
    = render "order_part_summary_row", label: "部品番号不明小計", value: c_subtotal
  = render "order_part_summary_row", label: "合計", value: total
  = render "order_part_discount_row", order: @order, after_discount: after_discount
  = render "order_part_tax_row", order: @order, tax_rate: tax_rate, tax: tax, grand_total: grand_total
