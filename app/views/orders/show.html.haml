%table
  %tr
    %td{style:"padding: 5px 5px 5px 30px;"}
      %form.flex.items-center.gap-1{method: "post", action: "#{orders_search_path}"}
        %input.box.input.input-bordered.input-sm.border-2.border-neutral.bg-base-100{maxlength: "11", name: "keyword", size: "11", type: "text", style: "ime-mode:disabled; width: 7.5rem;", value: "#{session[:yearmonth]}"}
        %input.btn.btn-sm.wtext.btn-info{name: "submit", type: "submit", value: "取引番号"}
        = hidden_field_tag('authenticity_token', form_authenticity_token)
    %td{style:"padding: 5px 5px 5px 30px;"}
      %form{method:"post", action: "#{orders_keycopy_path}", name: "order_key_copy"}
        = hidden_field_tag('authenticity_token', form_authenticity_token)
        %input{type: "submit", value: "取引先、船名、機番を複製し新規取引登録", class: "btn wtext btn-info"}
    %td{style:"padding: 5px 5px 5px 30px;"}
      %form{method:"post", action: "#{orders_copy_path}", name: "order_copy"}
        = hidden_field_tag('authenticity_token', form_authenticity_token)
        %input{type: "submit", value: "部品詳細も複製し新規取引登録",  class: "btn wtext btn-info"}
    %td{style:"padding: 5px 5px 5px 30px;"}
      = link_to "台帳を修正", edit_order_path,  class: "btn wtext btn-info"
    %td{style:"padding: 5px 5px 5px 30px;"}
      = link_to "台帳から削除", order_path, method: :delete, data: {confirm: "本当に削除しますか？"}, class: "btn wtext btn-info"
    %td{style:"padding: 5px 5px 5px 30px;"}
      = link_to "並び替え後表示(仮)", sorted_order_path(@order), class: "btn wtext btn-info"
%table.center-table.radius-table.row-compact{width: "99%", align:"center"}
  %tr
    %th.bg-primary.text-primary-content{width:"150px", style: 'font-size: 11px;'} 取引管理No.
    %td{width:"120px",style:'text-align:center;'}= @order.mno
    %th.bg-primary.text-primary-content{width:"90px", style: 'font-size: 11px;'} 会社名
    %td{style:'text-align:center;'}
      - adlist = Adlist.find_by(no: @order.adlist_id.to_s)
      - if adlist
        = link_to adlist.company, adlist
    %th.bg-primary.text-primary-content{width:"80px", style: 'font-size: 11px;'} 部署名
    %td{style:'text-align:center;'}
      - if adlist
        = adlist.section
    %th.bg-primary.text-primary-content{width:"60px", style: 'font-size: 11px;'} 船名
    %td{style:'text-align:center;'}
      = @order.shipname
    %th.bg-primary.text-primary-content{width:"60px", style: 'font-size: 11px;'} 船籍
    %td{style:'text-align:center;'}
      = @order.country
%table.center-table.radius-table.row-compact{width: "99%", align:"center"}
  %tr
    %th.bg-primary.text-primary-content{width:"60px", style: 'font-size: 11px;'} 件名
